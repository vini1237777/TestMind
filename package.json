{
  "name": "testmind",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node server.js",
    "worker": "tsx src/worker/generation-worker.ts",
    "build:worker": "esbuild src/worker/generation-worker.ts --bundle --platform=node --target=node20 --outfile=dist/generation-worker.cjs --external:@mongodb-js/zstd --external:kerberos --external:snappy --external:aws4 --external:mongodb-client-encryption --external:gcp-metadata --external:socks --external:@aws-sdk/credential-providers",
    "start:pm2": "pm2-runtime ecosystem.config.js",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@langchain/core": "^1.1.35",
    "@langchain/langgraph": "^1.2.5",
    "@next/env": "^16.0.7",
    "@sentry/nextjs": "^10.45.0",
    "@upstash/ratelimit": "^2.0.7",
    "autocannon": "^8.0.0",
    "bullmq": "^5.81.5",
    "holy-loader": "^2.3.14",
    "i": "^0.3.7",
    "ioredis": "^5.8.2",
    "mongodb": "^7.0.0",
    "mongoose": "^8.20.0",
    "next": "^16.0.3",
    "next-themes": "^0.4.6",
    "npm": "^11.7.0",
    "openai": "^6.9.0",
    "pm2": "^6.0.14",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.9.0",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
