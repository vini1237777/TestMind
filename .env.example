OPENAI_API_KEY=
# Optional. Serves generation and review when OpenAI fails.
GEMINI_API_KEY=
MONGODB_URI=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# TCP Redis for the generation queue. Upstash REST above can't be used for this.
REDIS_URL=redis://localhost:6379
NEXT_PUBLIC_BASE_URL=http://localhost:3000
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional. "on" reuses earlier cases for near identical features in a project.
SEMANTIC_CACHE=
SEMANTIC_CACHE_THRESHOLD=0.95
# Optional. "on" adds similar saved cases from the same project to the generation
# prompt. Needs the Atlas index in atlas/test-case-chunks-vector-index.json.
RAG=
# Atlas score from 0 to 1 a saved case must reach to be used. Defaults to 0.75.
RAG_MIN_SCORE=
